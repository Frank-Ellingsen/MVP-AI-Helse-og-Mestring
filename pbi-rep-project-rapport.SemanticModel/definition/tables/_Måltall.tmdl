	measure 'Corr Regnskap vs Budsjett' =
			VAR T =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( 'dim_date'[Maned_Navn] ),
			            "@Regnskap", CALCULATE ( [Sum Regnskap] ),
			            "@Budsjett", CALCULATE ( [Sum Budsjett] )
			        ),
			        NOT ISBLANK ( [@Regnskap] ) && NOT ISBLANK ( [@Budsjett] )
			    )
			VAR AvgX = AVERAGEX ( T, [@Budsjett] )
			VAR AvgY = AVERAGEX ( T, [@Regnskap] )
			VAR Cov = SUMX ( T, ( [@Budsjett] - AvgX ) * ( [@Regnskap] - AvgY ) )
			VAR VarX = SUMX ( T, ( [@Budsjett] - AvgX ) ^ 2 )
			VAR VarY = SUMX ( T, ( [@Regnskap] - AvgY ) ^ 2 )
			VAR Denom = SQRT ( VarX * VarY )
			RETURN IF ( Denom > 0, DIVIDE ( Cov, Denom ) )
		formatString: 0.00
		displayFolder: 10. FT Visuals
		lineageTag: bcebd29b-da7f-4505-9a85-e8173b9727ef

	measure 'Correlation Strength' =
			VAR R = [Corr Regnskap vs Budsjett]
			VAR AbsR = ABS ( R )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( R ), "Ingen data",
			        AbsR >= 0.80, "Svært sterk",
			        AbsR >= 0.60, "Sterk",
			        AbsR >= 0.40, "Moderat",
			        AbsR >= 0.20, "Svak",
			        "Svært svak"
			    )
		displayFolder: 10. FT Visuals
		lineageTag: b3420fa3-9072-415f-92a3-28efeddb2f83

