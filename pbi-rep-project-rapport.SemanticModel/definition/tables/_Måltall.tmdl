	measure 'ERP Pareto Kumulativ %' =
			VAR CurrentDriver = [Merforbruk Kr]
			VAR TotalDriver = CALCULATE ( [Merforbruk Kr], ALLSELECTED ( 'dim_kostra_kontoplan' ) )
			RETURN
			    IF (
			        CurrentDriver > 0,
			        DIVIDE (
			            CALCULATE (
			                [Merforbruk Kr],
			                FILTER (
			                    ALLSELECTED ( 'dim_kostra_kontoplan'[Konto_Kode_Navn] ),
			                    [Merforbruk Kr] >= CurrentDriver
			                )
			            ),
			            TotalDriver,
			            0
			        )
			    )
		formatString: 0.0 %
		displayFolder: 06. Driveranalyse
		lineageTag: a566d05d-a9c3-4397-94d5-559d0528f5c8

	measure 'Dynamisk Rapporttittel' = [Txt Master Selection Header]
		displayFolder: 07. Dynamisk Tekst
		lineageTag: 9f47197b-8bd6-4646-9468-c32734eda5cb

	measure 'Story Executive Summary' =
			VAR AvvikYTD = [Avvik YTD Kr]
			VAR AvvikPct = [Avvik YTD %]
			RETURN
			    IF (
			        AvvikYTD < 0,
			        "MERFORBRUK: Regnskap overskrider budsjett med " & FORMAT ( ABS ( AvvikYTD ), "#,##0 kr" ) & " (" & FORMAT ( ABS ( AvvikPct ), "0.0%" ) & ") YTD. Kostnadspresset drives av eksterne vikarer og overtid.",
			        "MINDREFORBRUK: Regnskap viser et samlet mindreforbruk på " & FORMAT ( AvvikYTD, "#,##0 kr" ) & " (" & FORMAT ( AvvikPct, "0.0%" ) & ") YTD."
			    )
		displayFolder: 07. Dynamisk Tekst
		lineageTag: 67d89347-78b8-46e3-8d13-5a8ba57bf909

	measure 'Story Time Narrative' = "TIDSTREND | Rapportert t.o.m. august 2024. Gjennomsnittlig månedlig forbruk er 3,94 MNOK. 3-måneders glidende snitt viser vedvarende høyt kostnadsnivå i skolesektoren."
		displayFolder: 07. Dynamisk Tekst
		lineageTag: 2f032758-5905-489e-8be5-5678d2ff0505

	measure 'Story Forecast Narrative' =
			VAR RunRate = [EOY Estimat Lineær]
			VAR Budget = [Årsbudsjett]
			VAR Gap = [EOY Estimert Avvik Kr]
			RETURN "PROGNOSE EOY | Ved uendret driftstakt lander året på " & FORMAT ( RunRate, "#,##0 kr" ) & " mot årsbudsjett på " & FORMAT ( Budget, "#,##0 kr" ) & ", som tilsier et estimert avvik på " & FORMAT ( Gap, "+#,##0 kr;-#,##0 kr;0 kr" ) & "."
		displayFolder: 07. Dynamisk Tekst
		lineageTag: 92587aaf-7809-4184-bbfc-d90720fdbd52

	measure 'Story Root Cause Detail' = "AVVIKSANALYSE | Ubesatte faste stillinger i Helse (+2,95 MNOK) står i kontrast til høyt overforbruk på vikarer (-381 kNOK) og overtid (-230 kNOK) i Oppvekst og Utdanning."
		displayFolder: 07. Dynamisk Tekst
		lineageTag: fe45514a-47d5-4e53-8269-d61f4daa419d

	measure 'Forecast Action Summary' =
			VAR Gap = [EOY Estimert Avvik Kr]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Gap ), "Ingen prognose tilgjengelig.",
			        Gap >= 0, "Prognosen indikerer balanse eller mindreforbruk ved årets slutt.",
			        "Prognosert merforbruk krever tiltak for å oppnå balanse innen 31.12.2024."
			    )
		displayFolder: 07. Dynamisk Tekst
		lineageTag: cac33af4-0158-4b8b-ba7b-7a944fb3078d

	measure 'Simulert Totale Tiltak Kr' = [Simulert Kutt Hoveddrivere Kr] + [Simulert Frigjort Mindreforbruk Kr]
