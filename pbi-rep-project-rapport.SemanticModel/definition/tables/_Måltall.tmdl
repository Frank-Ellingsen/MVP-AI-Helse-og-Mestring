table _Måltall
	lineageTag: 58123772-c943-459f-92eb-87f9d96eb8b0

	measure 'Sum Regnskap' = SUM ( 'fact_data'[Regnskap] )
		formatString: #,##0 NOK
		displayFolder: 01. Kjerne
		lineageTag: 138e4b59-11b4-4329-b213-f142be244b20

	measure 'Sum Budsjett' = SUM ( 'fact_data'[Budsjett] )
		formatString: #,##0 NOK
		displayFolder: 01. Kjerne
		lineageTag: bec4aacb-2309-4e8f-becb-585de0afbeaf

	measure Årsbudsjett =
			CALCULATE (
			    [Sum Budsjett],
			    ALL ( 'dim_date' ),
			    VALUES ( 'dim_date'[Ar] )
			)
		formatString: #,##0 NOK
		displayFolder: 01. Kjerne
		lineageTag: ef3a33a8-cd23-4462-bec4-e6250fb05fbb

	measure 'Avvik Kr' = [Sum Budsjett] - [Sum Regnskap]
		formatString: #,##0 NOK
		displayFolder: 01. Kjerne
		lineageTag: 0113977c-36fe-4f4f-8730-2a83e355afb2

	measure 'Forbruk %' = DIVIDE ( [Sum Regnskap], [Sum Budsjett], 0 )
		formatString: 0.0 %
		displayFolder: 01. Kjerne
		lineageTag: af7e0794-a8eb-4271-a0dc-352e3bf45904

	measure 'Avvik %' = DIVIDE ( [Avvik Kr], [Sum Budsjett], 0 )
		formatString: 0.0 %
		displayFolder: 01. Kjerne
		lineageTag: 680667f3-ff5c-49f9-806e-a4c7543cb78b

	measure 'Regnskap PM' =
			CALCULATE (
			    [Sum Regnskap],
			    DATEADD ( 'dim_date'[Dato], -1, MONTH )
			)
		formatString: #,##0 NOK
		displayFolder: 02. MoM & Trend
		lineageTag: 179ad0e9-a90e-4480-a274-acc1be7da4e0

	measure 'Budsjett PM' =
			CALCULATE (
			    [Sum Budsjett],
			    DATEADD ( 'dim_date'[Dato], -1, MONTH )
			)
		formatString: #,##0 NOK
		displayFolder: 02. MoM & Trend
		lineageTag: b81c031b-50a9-4743-8712-423e0cda5d0c

	measure 'Regnskap MoM Endring Kr' =
			IF (
			    NOT ISBLANK ( [Regnskap PM] ),
			    [Sum Regnskap] - [Regnskap PM]
			)
		formatString: #,##0 NOK
		displayFolder: 02. MoM & Trend
		lineageTag: 1edc7ce4-2e82-44ee-8219-dbdd4ef4dd4b

	measure 'Regnskap MoM Endring %' = DIVIDE ( [Regnskap MoM Endring Kr], [Regnskap PM], 0 )
		formatString: 0.0 %
		displayFolder: 02. MoM & Trend
		lineageTag: e4bf55e1-13bd-4768-9ea8-582e79988c98

	measure 'Regnskap 3M Moving Average' =
			AVERAGEX (
			    DATESINPERIOD (
			        'dim_date'[Dato],
			        LASTDATE ( 'dim_date'[Dato] ),
			        -3,
			        MONTH
			    ),
			    [Sum Regnskap]
			)
		formatString: #,##0 NOK
		displayFolder: 02. MoM & Trend
		lineageTag: e829c332-8f74-4ca4-bb0a-ea14b0d2f181

	measure 'Regnskap Base 100' =
			VAR _Base =
			    CALCULATE (
			        [Sum Regnskap],
			        'dim_date'[Maned_Nummer] = 1,
			        ALL ( 'dim_date'[Maned_Navn], 'dim_date'[month], 'dim_date'[Maned_Nummer], 'dim_date'[Dato] )
			    )
			RETURN
			    IF ( NOT ISBLANK ( [Sum Regnskap] ) && _Base > 0, DIVIDE ( [Sum Regnskap], _Base, 1 ) * 100 )
		formatString: 0.0
		displayFolder: 02. MoM & Trend
		lineageTag: 37cab333-f21e-4d52-a1b0-0c8e6b4f9b2a

	measure 'Regnskap YTD' = TOTALYTD ( [Sum Regnskap], 'dim_date'[Dato] )
		formatString: #,##0 NOK
		displayFolder: 03. YTD
		lineageTag: e9f10c9a-88b3-4876-b278-fbe064899706

	measure 'Budsjett YTD' = TOTALYTD ( [Sum Budsjett], 'dim_date'[Dato] )
		formatString: #,##0 NOK
		displayFolder: 03. YTD
		lineageTag: 1be7064a-cb44-4c99-9ffb-59f337249e74

	measure 'Avvik YTD Kr' = [Budsjett YTD] - [Regnskap YTD]
		formatString: #,##0 NOK
		displayFolder: 03. YTD
		lineageTag: 437a3602-d84c-4e9e-945b-0329b448d5cb

	measure 'Avvik YTD %' = DIVIDE ( [Avvik YTD Kr], [Budsjett YTD], 0 )
		formatString: 0.0 %
		displayFolder: 03. YTD
		lineageTag: f1222945-349b-41cb-8f2c-e3e014d59d29

	measure 'Budsjett Resten av Året' =
			CALCULATE (
			    [Sum Budsjett],
			    DATESBETWEEN (
			        'dim_date'[Dato],
			        MAX ( 'dim_date'[Dato] ) + 1,
			        ENDOFYEAR ( 'dim_date'[Dato] )
			    )
			)
		formatString: #,##0 NOK
		displayFolder: 04. Prognose & EOY
		lineageTag: 49993478-6366-4354-a936-3752138117ac

	measure 'EOY Estimat Lineær' = [Regnskap YTD] + [Budsjett Resten av Året]
		formatString: #,##0 NOK
		displayFolder: 04. Prognose & EOY
		lineageTag: 3287c781-fb8f-4cac-8307-c42950fa2a6d

	measure 'EOY Estimert Avvik Kr' = [Årsbudsjett] - [EOY Estimat Lineær]
		formatString: #,##0 NOK
		displayFolder: 04. Prognose & EOY
		lineageTag: 0f277c24-9ac8-4524-a046-83f747cf5aed

	measure 'EOY Estimert Avvik %' = DIVIDE ( [EOY Estimert Avvik Kr], [Årsbudsjett], 0 )
		formatString: 0.0 %
		displayFolder: 04. Prognose & EOY
		lineageTag: 7e3e86e1-5887-487c-bca0-48dcf4e3ffe1

	measure 'Bullet Target 80%' = [Budsjett YTD] * 0.80
		formatString: #,##0 NOK
		displayFolder: 04. Prognose & EOY
		lineageTag: db2bbfd3-ebcf-48ac-b8bd-89e7a199f1cd

	measure 'Bullet Target 110%' = [Budsjett YTD] * 1.10
		formatString: #,##0 NOK
		displayFolder: 04. Prognose & EOY
		lineageTag: d49394df-f00b-46cf-a989-fec6644b1b4a

	measure 'RAG Farge Avvik' =
			VAR _AvvikPct = [Avvik YTD %]
			RETURN
			    SWITCH (
			        TRUE (),
			        _AvvikPct < -0.05, "#D13438", // Muted rød: Merforbruk > 5%
			        _AvvikPct < 0.00,  "#FFB900", // Muted amber: Mindre merforbruk (0-5%)
			        _AvvikPct >= 0.05, "#0078D4", // Stålblå: Betydelig mindreforbruk (> 5%)
			        "#107C41"                    // Skogsgrønn: I rute / Mindreforbruk
			    )
		displayFolder: 05. RAG & Formatering
		lineageTag: 2d9f1da5-2817-47bc-a869-05aad3a04c9d

	measure 'RAG Ikon Avvik' =
			VAR _AvvikPct = [Avvik YTD %]
			RETURN
			    SWITCH (
			        TRUE (),
			        _AvvikPct < -0.05, "🔴",
			        _AvvikPct < 0.00,  "🟡",
			        _AvvikPct >= 0.05, "🔵",
			        "🟢"
			    )
		displayFolder: 05. RAG & Formatering
		lineageTag: 2a75ff9d-a7d2-4843-8ef4-ad0bd7ebfb1a

	measure 'Status Indikator' =
			VAR _AvvikPct = [Avvik YTD %]
			RETURN
			    SWITCH (
			        TRUE (),
			        _AvvikPct < -0.05, "🔴 Vesentlig merforbruk (>5%)",
			        _AvvikPct < 0.00,  "🟡 Mindre merforbruk (0-5%)",
			        _AvvikPct >= 0.05, "🔵 Betydelig mindreforbruk (>5%)",
			        "🟢 I rute / Mindreforbruk"
			    )
		displayFolder: 05. RAG & Formatering
		lineageTag: 4dcfeb72-fc8e-409e-9fb9-aaf9397ac10b

	measure 'Avvik Bar Farge' = IF ( [Avvik Kr] < 0, "#D13438", "#107C41" )
		displayFolder: 05. RAG & Formatering
		lineageTag: fb0db52c-a80f-4bb9-850a-e8017aece2b5

	measure 'Merforbruk Kr' =
			VAR _Avvik = [Avvik Kr]
			RETURN
			    IF ( _Avvik < 0, ABS ( _Avvik ), 0 )
		formatString: #,##0 NOK
		displayFolder: 06. Driveranalyse
		lineageTag: 3474814f-161b-4472-affc-8bcb0e528df2

	measure 'Mindreforbruk Kr' =
			VAR _Avvik = [Avvik Kr]
			RETURN
			    IF ( _Avvik > 0, _Avvik, 0 )
		formatString: #,##0 NOK
		displayFolder: 06. Driveranalyse
		lineageTag: a3446152-6990-4041-9f0b-8269f59ccb92

	measure 'Pct Bidrag til Totalt Merforbruk' =
			VAR _TotaltMerforbruk =
			    CALCULATE (
			        [Merforbruk Kr],
			        ALLSELECTED ( 'dim_ansvar' ),
			        ALLSELECTED ( 'dim_kostra_kontoplan' ),
			        ALLSELECTED ( 'dim_kostra_funksjon' )
			    )
			RETURN
			    DIVIDE ( [Merforbruk Kr], _TotaltMerforbruk, 0 )
		formatString: 0.0 %
		displayFolder: 06. Driveranalyse
		lineageTag: ca155582-2c37-4f1a-897c-3fd9fd79727a

	measure 'Pct Bidrag til Total Regnskap' =
			VAR _TotalRegnskap =
			    CALCULATE (
			        [Sum Regnskap],
			        ALLSELECTED ( 'dim_ansvar' ),
			        ALLSELECTED ( 'dim_kostra_kontoplan' ),
			        ALLSELECTED ( 'dim_kostra_funksjon' )
			    )
			RETURN
			    DIVIDE ( [Sum Regnskap], _TotalRegnskap, 0 )
		formatString: 0.0 %
		displayFolder: 06. Driveranalyse
		lineageTag: 6b5dc18c-6593-42d2-aeb5-fc980afe97d8

	measure 'Rangering Merforbruk' =
			IF (
			    [Merforbruk Kr] > 0,
			    RANKX (
			        ALLSELECTED ( 'dim_kostra_kontoplan'[Konto_Kode_Navn] ),
			        [Merforbruk Kr],
			        ,
			        DESC,
			        Dense
			    )
			)
		formatString: 0
		displayFolder: 06. Driveranalyse
		lineageTag: 70f040f3-875a-4919-b5ed-6d1c0feb2543

	measure 'Kostnad Vikarer Kr' =
			CALCULATE (
			    [Sum Regnskap],
			    'dim_kostra_kontoplan'[Kontokode_6Siffer] IN { "102000", "102013", "127040" }
			)
		formatString: #,##0 NOK
		displayFolder: 06. Driveranalyse
		lineageTag: 6c523377-e6f5-45a8-80ba-3ebd4a2af792

	measure 'Kostnad Overtid Kr' =
			CALCULATE (
			    [Sum Regnskap],
			    'dim_kostra_kontoplan'[Kontokode_6Siffer] = "104000"
			)
		formatString: #,##0 NOK
		displayFolder: 06. Driveranalyse
		lineageTag: 50e3ef1b-983e-4187-835c-7c4f922c8e3f

	measure 'Txt Valgt År' = SELECTEDVALUE ( 'dim_date'[Ar], "Alle År (2024)" )
		displayFolder: 07. Dynamisk Tekst
		lineageTag: b064909a-8596-4f5a-b395-a0003786747b

	measure 'Txt Valgt Måned' =
			IF (
			    ISFILTERED ( 'dim_date'[Maned_Navn] ),
			    CONCATENATEX ( VALUES ( 'dim_date'[Maned_Navn] ), 'dim_date'[Maned_Navn], ", " ),
			    "Alle Måneder (Jan - Aug)"
			)
		displayFolder: 07. Dynamisk Tekst
