	measure 'Simulert Kutt Hoveddrivere Kr' =
			// 50% reduksjon i vikar og overtid (konto 102013, 102000, 104000)
			CALCULATE (
			    [Merforbruk Kr] * 0.50,
			    'dim_kostra_kontoplan'[Kontokode_6Siffer] IN { "102013", "102000", "104000" }
			)
		formatString: #,##0 NOK
		displayFolder: 08. What-If Simulering
		lineageTag: abf7acc1-35e7-43df-b719-589230dcae28

	measure 'Simulert Frigjort Mindreforbruk Kr' =
			// Frigjør inntil 20% av mindreforbruk på ordinær lønn til omdisponering
			CALCULATE (
			    [Mindreforbruk Kr] * 0.20,
			    'dim_kostra_kontoplan'[Kontokode_6Siffer] IN { "101000", "109000" }
			)
		formatString: #,##0 NOK
		displayFolder: 08. What-If Simulering
		lineageTag: 05ce83c1-43ab-41d9-90ae-ea2fe3de3719

	measure 'Simulert EOY Avvik Etter Tiltak Kr' = [EOY Estimert Avvik Kr] + [Simulert Totale Tiltak Kr]
