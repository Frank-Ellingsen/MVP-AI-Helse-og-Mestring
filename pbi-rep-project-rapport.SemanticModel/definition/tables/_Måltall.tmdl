	measure 'ERP Actual Historical' =
			VAR LastActualDate = LASTDATE ( 'fact_data'[Dato] )
			VAR CurrentDate = MAX ( 'dim_date'[Dato] )
			RETURN IF ( CurrentDate <= LastActualDate, [Sum Regnskap], BLANK () )
		formatString: #,##0 NOK
		displayFolder: 09. Tufte S-Curve
		lineageTag: b8e59319-3bfc-47a7-9108-bf680580f709

	measure 'ERP Forecast Trend' =
			VAR LastActualDate = LASTDATE ( 'fact_data'[Dato] )
			VAR CurrentDate = MAX ( 'dim_date'[Dato] )
			RETURN IF ( CurrentDate > LastActualDate, [Regnskap 3M Moving Average], BLANK () )
		formatString: #,##0 NOK
		displayFolder: 09. Tufte S-Curve
		lineageTag: d7d185b9-a104-48ed-8409-42ebe8bd15b0

