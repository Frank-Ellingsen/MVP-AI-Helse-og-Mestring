	measure 'QA Duplikatsjekk Filnavn' =
			VAR _AntallFilerPerPeriodeOgSektor =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'fact_data', 'dim_date'[yyyy-mm], 'fact_data'[Sektor] ),
			            "@FilCount", CALCULATE ( DISTINCTCOUNT ( 'fact_data'[Source.Name] ) )
			        ),
			        ALL ( 'fact_data'[Source.Name] )
			    )
			VAR _MaksFiler = MAXX ( _AntallFilerPerPeriodeOgSektor, [@FilCount] )
			RETURN
			    IF ( _MaksFiler > 1, "⚠️ ADVARSEL: Dupliserte filer for samme periode!", "🟢 Ingen filduplikater" )
		displayFolder: 11. DQA Kontroller
